# --- Database (same MongoDB / collection your current app uses) ---
MONGODB_URI=mongodb+srv://USER:PASSWORD@HOST/?retryWrites=true&w=majority
MONGODB_DB=serviceDB

# --- Login (checked on the server only) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# Long random string used to sign the session cookie:  openssl rand -hex 32
AUTH_SECRET=

# --- Display timezone offset from UTC in hours (Bangladesh = 6) ---
TZ_OFFSET_HOURS=6

# --- Optional: post an entry to your Account Manager when a retail device is marked sold ---
# Leave TRANSACTION_URL empty to turn this off.
TRANSACTION_URL=
TRANSACTION_API_TOKEN=
PROJECT_ID=
RETAIL_DEVICES_SALES_ID=
DEVICE_SALE_DEPOSIT_ID=

# --- Due list: IDs of devices already connected on the tracking servers ---
# Each URL returns a JSON array of device IDs. Leave empty to hide the due numbers.
RETAIL_ASSIGN_ID=
TIKTIKI_ASSIGN_ID=
# Token for both URLs. Either the bare token or the full "BEARER <token>" text works.
# Put it in single quotes. If it contains $ write each one as \$ (a plain $ is treated as a variable).
AUTH_TOKEN=
# If the token has $ or # and you keep getting 401, use this instead of AUTH_TOKEN (see README):
AUTH_TOKEN_B64=
